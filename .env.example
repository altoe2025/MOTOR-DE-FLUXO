APP_ENV=development
# Defaults: development 127.0.0.1:8000; production 0.0.0.0:$PORT.
# Export these entrypoint variables into the process environment.
# The application Settings reads .env; the entrypoint reads the process environment.
# Render supplies PORT; do not override it in render.yaml.
HOST=127.0.0.1
PORT=8000
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ALLOWED_USER_IDS=00000000-0000-4000-8000-000000000000
MOTOR_BUILD_SHA=0000000000000000000000000000000000000000
WEB_DIST_DIR=web/dist
# Optional chat: enable only with a backend key and explicitly selected model.
CHAT_ENABLED=false
# Set only in the server runtime. Never use a VITE_ prefix for this key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Positive finite seconds; output budget is 1..4096 tokens (answer <=12000 chars).
OPENAI_CHAT_TIMEOUT_SECONDS=30
OPENAI_CHAT_MAX_OUTPUT_TOKENS=2048
