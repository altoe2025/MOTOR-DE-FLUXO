{
  "$id": "https://motor-de-fluxo.local/study/study.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 200 },
    "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "UtcInstant": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "ObservedSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "OBSERVED_CASE" },
        "caseId": { "$ref": "#/$defs/Identifier" },
        "caseRevision": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "caseId", "caseRevision"]
    },
    "AuthoredParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frequency": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "ticket": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "direction": { "enum": ["OUT", "IN", "MIXED"] },
        "deadline": { "type": "string", "pattern": "^[0-9]+$" },
        "purpose": { "$ref": "#/$defs/Identifier" },
        "profile": { "enum": ["remessa_outbound_massiva", "psp_inbound", "cripto_native_sem_fiat", "payroll_fornecedor", "exportador", "tesouraria_corporativa"] }
      },
      "required": ["frequency", "ticket", "direction", "deadline", "purpose", "profile"]
    },
    "AuthoredParticipant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "name": { "$ref": "#/$defs/Identifier" },
        "override": { "type": "boolean" },
        "parameters": { "$ref": "#/$defs/AuthoredParameters" }
      },
      "required": ["id", "name", "override", "parameters"]
    },
    "AuthoredGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "name": { "$ref": "#/$defs/Identifier" },
        "parameters": { "$ref": "#/$defs/AuthoredParameters" },
        "participants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/AuthoredParticipant" } }
      },
      "required": ["id", "name", "parameters", "participants"]
    },
    "OrderFieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "cliente_id": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "direcao": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "dia_conhecida": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "dia_limite": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "eh_efx": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "finalidade": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
        "valor_brl": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" }
      },
      "required": ["dia_conhecida", "dia_limite", "eh_efx", "finalidade", "valor_brl"]
    },
    "AuthoredDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "PARAMETRIC" },
            "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/AuthoredGroup" } }
          },
          "required": ["kind", "groups"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "EXPLICIT_ORDERS" },
            "derivedFromObservedCase": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "caseId": { "$ref": "#/$defs/Identifier" },
                "caseRevision": { "type": "integer", "minimum": 1 }
              },
              "required": ["caseId", "caseRevision"]
            },
            "orders": { "type": "array", "items": { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/OrdemEntrada" } },
            "provenanceByOrder": { "type": "object", "additionalProperties": { "$ref": "#/$defs/OrderFieldProvenance" } }
          },
          "required": ["kind", "orders", "provenanceByOrder"]
        }
      ]
    },
    "AuthoredSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "AUTHORED" },
        "authoredPortfolioId": { "$ref": "#/$defs/Identifier" },
        "definition": { "$ref": "#/$defs/AuthoredDefinition" }
      },
      "required": ["kind", "authoredPortfolioId"]
    },
    "SyntheticRecipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exampleId": { "$ref": "#/$defs/Identifier" },
        "seeds": {
          "type": "array",
          "items": {
            "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/EffectiveParticipant/properties/seed"
          }
        },
        "composition": {
          "type": "array",
          "items": {
            "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/RealizedComposition"
          }
        },
        "preparationVersion": { "$ref": "#/$defs/Identifier" },
        "generatorVersion": { "$ref": "#/$defs/Identifier" },
        "motorBuildSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "generationFingerprint": { "$ref": "#/$defs/Digest" }
      },
      "required": [
        "exampleId", "seeds", "composition", "preparationVersion", "generatorVersion",
        "motorBuildSha", "generationFingerprint"
      ]
    },
    "SyntheticSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "SYNTHETIC" },
        "recipe": { "$ref": "#/$defs/SyntheticRecipe" }
      },
      "required": ["kind", "recipe"]
    },
    "PortfolioSource": {
      "oneOf": [
        { "$ref": "#/$defs/ObservedSource" },
        { "$ref": "#/$defs/AuthoredSource" },
        { "$ref": "#/$defs/SyntheticSource" }
      ]
    },
    "PortfolioSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/PortfolioSource" },
        "capturedAt": { "$ref": "#/$defs/UtcInstant" },
        "orders": {
          "type": "array",
          "items": { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/OrdemEntrada" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" }
        },
        "provenanceByOrder": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/OrderFieldProvenance" }
        },
        "observedOutcome": {
          "oneOf": [
            { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/ObservedOutcome" },
            { "type": "null" }
          ]
        },
        "sourceFingerprint": { "$ref": "#/$defs/Digest" }
      },
      "required": [
        "source", "capturedAt", "orders", "provenance", "observedOutcome", "sourceFingerprint"
      ]
    },
    "PremisesDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "costs": { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/CustoEntrada" },
        "windowDays": { "type": "integer", "minimum": 1, "maximum": 730 }
      },
      "required": ["costs", "windowDays"]
    },
    "PeriodDocument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpPeriod": {
              "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/PeriodoLegado"
            },
            "executableHorizonDays": { "type": "integer", "minimum": 0, "maximum": 730 }
          },
          "required": ["httpPeriod", "executableHorizonDays"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpPeriod": {
              "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/PeriodoNatural"
            }
          },
          "required": ["httpPeriod"]
        }
      ]
    },
    "ScenarioInputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "premises": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windowDays": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
            "costs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "iof_out": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "iof_in": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "carry_cnr": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "custo_fixo_remessa": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "custo_oportunidade_aa": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "spread_rail_bps": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" },
                "ptax": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" }
              },
              "required": [
                "iof_out", "iof_in", "carry_cnr", "custo_fixo_remessa",
                "custo_oportunidade_aa", "spread_rail_bps", "ptax"
              ]
            }
          },
          "required": ["windowDays", "costs"]
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizonDays": { "$ref": "https://motor-de-fluxo.local/cases/observedCase.schema.json#/$defs/FieldProvenance" }
          },
          "required": ["horizonDays"]
        }
      },
      "required": ["premises", "period"]
    },
    "ScenarioDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceSnapshot": { "$ref": "#/$defs/PortfolioSourceSnapshot" },
        "premises": { "$ref": "#/$defs/PremisesDocument" },
        "period": { "$ref": "#/$defs/PeriodDocument" },
        "inputProvenance": { "$ref": "#/$defs/ScenarioInputProvenance" },
        "inputFingerprint": { "$ref": "#/$defs/Digest" }
      },
      "required": [
        "id", "revision", "name", "sourceSnapshot", "premises", "period", "inputFingerprint"
      ]
    },
    "ExecutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "attemptId": { "$ref": "#/$defs/Identifier" },
        "scenarioId": { "$ref": "#/$defs/Identifier" },
        "scenarioRevision": { "type": "integer", "minimum": 1 },
        "inputFingerprint": { "$ref": "#/$defs/Digest" },
        "requestSnapshot": { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/PreviaRequest" },
        "sourceSnapshot": { "$ref": "#/$defs/PortfolioSourceSnapshot" },
        "premisesSnapshot": { "$ref": "#/$defs/PremisesDocument" },
        "periodSnapshot": { "$ref": "#/$defs/PeriodDocument" },
        "engineVersion": { "$ref": "#/$defs/Identifier" },
        "contractVersion": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["PREPARING", "RUNNING", "SUCCEEDED", "FAILED", "INTERRUPTED"] },
        "envelope": {
          "oneOf": [
            { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/PreviewEnvelope" },
            { "type": "null" }
          ]
        },
        "observedComparison": { "type": ["object", "null"] },
        "createdAt": { "$ref": "#/$defs/UtcInstant" },
        "finishedAt": {
          "oneOf": [{ "$ref": "#/$defs/UtcInstant" }, { "type": "null" }]
        }
      },
      "required": [
        "id", "scenarioId", "scenarioRevision", "inputFingerprint", "requestSnapshot",
        "engineVersion", "contractVersion", "status", "envelope", "observedComparison",
        "createdAt", "finishedAt"
      ],
      "dependentRequired": {
        "sourceSnapshot": ["premisesSnapshot", "periodSnapshot"],
        "premisesSnapshot": ["sourceSnapshot", "periodSnapshot"],
        "periodSnapshot": ["sourceSnapshot", "premisesSnapshot"]
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] },
          "then": {
            "properties": {
              "envelope": { "$ref": "https://motor-de-fluxo.local/contracts/schemas.json#/$defs/PreviewEnvelope" },
              "finishedAt": { "$ref": "#/$defs/UtcInstant" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["PREPARING", "RUNNING"] } }, "required": ["status"] },
          "then": {
            "properties": { "envelope": { "type": "null" }, "finishedAt": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["FAILED", "INTERRUPTED"] } }, "required": ["status"] },
          "then": {
            "properties": {
              "envelope": { "type": "null" },
              "finishedAt": { "$ref": "#/$defs/UtcInstant" }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "$ref": "#/$defs/Identifier" },
    "ownerSub": { "$ref": "#/$defs/Identifier" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 },
    "baseScenarioId": { "$ref": "#/$defs/Identifier" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ScenarioDocument" } },
    "executions": { "type": "array", "items": { "$ref": "#/$defs/ExecutionRecord" } },
    "createdAt": { "$ref": "#/$defs/UtcInstant" },
    "updatedAt": { "$ref": "#/$defs/UtcInstant" },
    "deletedAt": { "oneOf": [{ "$ref": "#/$defs/UtcInstant" }, { "type": "null" }] }
  },
  "required": [
    "schemaVersion", "id", "ownerSub", "name", "revision", "baseScenarioId",
    "scenarios", "executions", "createdAt", "updatedAt", "deletedAt"
  ]
}
