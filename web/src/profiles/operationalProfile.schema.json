{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motor-de-fluxo.local/profiles/operationalProfile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": { "const": "AVAILABLE" },
            "value": {},
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["state", "value", "evidence"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["NOT_COLLECTED", "INSUFFICIENT_COVERAGE", "INCOMPATIBLE"] },
            "reason": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["state", "reason", "evidence"]
        }
      ]
    },
    "Window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "closingDate": { "type": "string", "format": "date" }
      },
      "required": ["startDate", "endDate", "closingDate"]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseCount": { "type": "integer", "minimum": 1 },
        "firstDate": { "type": "string", "format": "date" },
        "lastDate": { "type": "string", "format": "date" },
        "totalWindowDays": { "type": "integer", "minimum": 1 },
        "coveredDays": { "type": "integer", "minimum": 1 },
        "overlapDays": { "type": "integer", "minimum": 0 },
        "gapDays": { "type": "integer", "minimum": 0 },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "caseId": { "type": "string", "minLength": 1 },
              "caseRevision": { "type": "integer", "minimum": 1 },
              "startDate": { "type": "string", "format": "date" },
              "endDate": { "type": "string", "format": "date" },
              "durationDays": { "type": "integer", "minimum": 1 }
            },
            "required": ["caseId", "caseRevision", "startDate", "endDate", "durationDays"]
          }
        }
      },
      "required": ["caseCount", "firstDate", "lastDate", "totalWindowDays", "coveredDays", "overlapDays", "gapDays", "windows"]
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["code", "message", "caseIds"]
    },
    "EvidenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/Evidence" }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "ownerSub": { "type": "string", "minLength": 1 },
    "companyId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "const": "operational-profile-v1" },
        "version": { "const": "1.0.0" },
        "percentileMethod": { "const": "NEAREST_RANK" }
      },
      "required": ["id", "version", "percentileMethod"]
    },
    "selectedCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "caseRevision": { "type": "integer", "minimum": 1 },
          "caseFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "window": { "$ref": "#/$defs/Window" }
        },
        "required": ["caseId", "caseRevision", "caseFingerprint", "window"]
      }
    },
    "selectionFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "documentFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatible": { "const": true },
        "blockers": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/Issue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/Issue" } }
      },
      "required": ["compatible", "blockers", "warnings"]
    },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume": { "$ref": "#/$defs/EvidenceMap" },
        "frequency": { "$ref": "#/$defs/EvidenceMap" },
        "ticketsBrl": { "$ref": "#/$defs/EvidenceMap" },
        "direction": { "$ref": "#/$defs/Evidence" },
        "deadlineDays": { "$ref": "#/$defs/EvidenceMap" },
        "purposes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "byCode": { "$ref": "#/$defs/Evidence" },
            "knownCoverage": { "$ref": "#/$defs/Evidence" },
            "missing": { "$ref": "#/$defs/Evidence" }
          },
          "required": ["byCode", "knownCoverage", "missing"]
        },
        "windows": { "$ref": "#/$defs/Evidence" },
        "seasonality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observations": { "$ref": "#/$defs/Evidence" },
            "comparison": { "$ref": "#/$defs/Evidence" }
          },
          "required": ["observations", "comparison"]
        }
      },
      "required": ["volume", "frequency", "ticketsBrl", "direction", "deadlineDays", "purposes", "windows", "seasonality"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseEvidence": { "type": "array", "items": { "type": "string" } },
        "sourceFiles": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "normalizationVersions": { "type": "array", "items": { "type": "string" } },
        "fields": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["caseEvidence", "sourceFiles", "normalizationVersions", "fields"]
    }
  },
  "required": ["schemaVersion", "id", "ownerSub", "companyId", "version", "createdAt", "method", "selectedCases", "selectionFingerprint", "documentFingerprint", "compatibility", "coverage", "metrics", "provenance"]
}
