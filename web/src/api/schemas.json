{
  "$id": "https://motor-de-fluxo.local/contracts/schemas.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AgregadoDTO": {
      "additionalProperties": false,
      "properties": {
        "baseline_periodo": {
          "$ref": "#/$defs/CustosDTO"
        },
        "economia_periodo_brl": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Economia Periodo Brl",
          "type": "string"
        },
        "execucao_completa": {
          "$ref": "#/$defs/ResultadoLegadoDTO"
        },
        "ids_ordens_medidas": {
          "items": {
            "type": "string"
          },
          "title": "Ids Ordens Medidas",
          "type": "array"
        },
        "netado_periodo": {
          "$ref": "#/$defs/CustosDTO"
        },
        "taxa_netabilidade_periodo": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Taxa Netabilidade Periodo",
          "type": "string"
        },
        "volume_bruto_periodo_brl": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Volume Bruto Periodo Brl",
          "type": "string"
        },
        "volume_casado_periodo_brl": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Volume Casado Periodo Brl",
          "type": "string"
        },
        "volume_remetido_periodo_brl": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Volume Remetido Periodo Brl",
          "type": "string"
        }
      },
      "required": [
        "execucao_completa",
        "ids_ordens_medidas",
        "volume_bruto_periodo_brl",
        "volume_casado_periodo_brl",
        "volume_remetido_periodo_brl",
        "baseline_periodo",
        "netado_periodo",
        "economia_periodo_brl",
        "taxa_netabilidade_periodo"
      ],
      "title": "AgregadoDTO",
      "type": "object"
    },
    "AlocacaoDTO": {
      "additionalProperties": false,
      "properties": {
        "dia": {
          "title": "Dia",
          "type": "integer"
        },
        "ordem_id": {
          "title": "Ordem Id",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "CASADO",
            "REMETIDO"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "valor_brl": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Valor Brl",
          "type": "string"
        }
      },
      "required": [
        "ordem_id",
        "dia",
        "valor_brl",
        "tipo"
      ],
      "title": "AlocacaoDTO",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "const": "1.0.0",
          "title": "Catalog Version",
          "type": "string"
        },
        "generator_version": {
          "const": "dimensionamento-v1",
          "title": "Generator Version",
          "type": "string"
        },
        "max_expected_orders": {
          "const": 500,
          "title": "Max Expected Orders",
          "type": "integer"
        },
        "max_orders": {
          "const": 1000,
          "title": "Max Orders",
          "type": "integer"
        },
        "motor_build_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Motor Build Sha",
          "type": "string"
        },
        "motor_schema_version": {
          "const": "1.0.0",
          "title": "Motor Schema Version",
          "type": "string"
        },
        "preparation_version": {
          "const": "1.0.0",
          "title": "Preparation Version",
          "type": "string"
        },
        "presentation_version": {
          "const": "1.0.0",
          "title": "Presentation Version",
          "type": "string"
        },
        "preview_version": {
          "const": "1.0.0",
          "title": "Preview Version",
          "type": "string"
        }
      },
      "required": [
        "preparation_version",
        "preview_version",
        "presentation_version",
        "motor_schema_version",
        "generator_version",
        "catalog_version",
        "motor_build_sha",
        "max_orders",
        "max_expected_orders"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "CatalogResponse": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "const": "1.0.0",
          "title": "Catalog Version",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/CustoEntrada"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/ExampleTemplate"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Examples",
          "type": "array"
        },
        "motor_build_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Motor Build Sha",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProfileTemplate"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Profiles",
          "type": "array"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "catalog_version",
        "motor_build_sha",
        "profiles",
        "examples",
        "costs",
        "source",
        "recorded_at"
      ],
      "title": "CatalogResponse",
      "type": "object"
    },
    "CenarioEntrada": {
      "additionalProperties": false,
      "properties": {
        "custo": {
          "$ref": "#/$defs/CustoEntrada"
        },
        "horizonte_dias": {
          "maximum": 730,
          "minimum": 0,
          "title": "Horizonte Dias",
          "type": "integer"
        },
        "janela_dias": {
          "maximum": 730,
          "minimum": 1,
          "title": "Janela Dias",
          "type": "integer"
        },
        "ordens": {
          "items": {
            "$ref": "#/$defs/OrdemEntrada"
          },
          "maxItems": 1000,
          "title": "Ordens",
          "type": "array"
        }
      },
      "required": [
        "ordens",
        "janela_dias",
        "horizonte_dias",
        "custo"
      ],
      "title": "CenarioEntrada",
      "type": "object"
    },
    "CicloDTO": {
      "additionalProperties": false,
      "properties": {
        "alocacoes": {
          "items": {
            "$ref": "#/$defs/AlocacaoDTO"
          },
          "title": "Alocacoes",
          "type": "array"
        },
        "bruto_in": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Bruto In",
          "type": "string"
        },
        "bruto_out": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Bruto Out",
          "type": "string"
        },
        "casado": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Casado",
          "type": "string"
        },
        "dia": {
          "title": "Dia",
          "type": "integer"
        },
        "direcao_residuo": {
          "enum": [
            "OUT",
            "IN"
          ],
          "title": "Direcao Residuo",
          "type": "string"
        },
        "residuo": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Residuo",
          "type": "string"
        }
      },
      "required": [
        "dia",
        "alocacoes",
        "bruto_out",
        "bruto_in",
        "casado",
        "residuo",
        "direcao_residuo"
      ],
      "title": "CicloDTO",
      "type": "object"
    },
    "CustoEntrada": {
      "additionalProperties": false,
      "properties": {
        "carry_cnr": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Carry Cnr",
          "type": "string"
        },
        "custo_fixo_remessa": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Custo Fixo Remessa",
          "type": "string"
        },
        "custo_oportunidade_aa": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Custo Oportunidade Aa",
          "type": "string"
        },
        "iof_in": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Iof In",
          "type": "string"
        },
        "iof_out": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Iof Out",
          "type": "string"
        },
        "iof_por_finalidade": {
          "items": {
            "$ref": "#/$defs/RegraIOF"
          },
          "maxItems": 100,
          "title": "Iof Por Finalidade",
          "type": "array"
        },
        "ptax": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Ptax",
          "type": "string"
        },
        "spread_rail_bps": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Spread Rail Bps",
          "type": "string"
        }
      },
      "required": [
        "iof_out",
        "iof_in",
        "carry_cnr",
        "spread_rail_bps",
        "custo_fixo_remessa",
        "custo_oportunidade_aa",
        "ptax",
        "iof_por_finalidade"
      ],
      "title": "CustoEntrada",
      "type": "object"
    },
    "CustosDTO": {
      "additionalProperties": false,
      "properties": {
        "carry": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Carry",
          "type": "string"
        },
        "espera": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Espera",
          "type": "string"
        },
        "fixo": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Fixo",
          "type": "string"
        },
        "iof": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Iof",
          "type": "string"
        },
        "spread": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Spread",
          "type": "string"
        },
        "total": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Total",
          "type": "string"
        }
      },
      "required": [
        "iof",
        "carry",
        "spread",
        "espera",
        "fixo",
        "total"
      ],
      "title": "CustosDTO",
      "type": "object"
    },
    "DerivedEvidence": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "rule": {
          "enum": [
            "dimensionamento-v1",
            "geracao-v1",
            "soma-ordens-v1"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "inputs"
      ],
      "title": "DerivedEvidence",
      "type": "object"
    },
    "DiagnosticosExperimentaisDTO": {
      "additionalProperties": false,
      "properties": {
        "limite_intra_cliente_brl": {
          "title": "Limite Intra Cliente Brl",
          "type": "null"
        },
        "taxa_netabilidade_incremental": {
          "title": "Taxa Netabilidade Incremental",
          "type": "null"
        },
        "volume_casado_incremental_brl": {
          "title": "Volume Casado Incremental Brl",
          "type": "null"
        }
      },
      "required": [
        "limite_intra_cliente_brl",
        "volume_casado_incremental_brl",
        "taxa_netabilidade_incremental"
      ],
      "title": "DiagnosticosExperimentaisDTO",
      "type": "object"
    },
    "EffectiveInput": {
      "additionalProperties": false,
      "properties": {
        "costs": {
          "$ref": "#/$defs/CustoEntrada"
        },
        "measurement_days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Measurement Days",
          "type": "integer"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/EffectiveParticipant"
          },
          "maxItems": 100,
          "title": "Participants",
          "type": "array"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/EffectiveSource"
          },
          "title": "Sources",
          "type": "object"
        },
        "warmup_days": {
          "maximum": 365,
          "minimum": 0,
          "title": "Warmup Days",
          "type": "integer"
        },
        "window_days": {
          "maximum": 730,
          "minimum": 1,
          "title": "Window Days",
          "type": "integer"
        }
      },
      "required": [
        "participants",
        "warmup_days",
        "measurement_days",
        "window_days",
        "costs",
        "sources"
      ],
      "title": "EffectiveInput",
      "type": "object"
    },
    "EffectiveParticipant": {
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProfileDeadline"
            },
            {
              "$ref": "#/$defs/FixedDeadline"
            }
          ],
          "title": "Deadline"
        },
        "eh_efx": {
          "title": "Eh Efx",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "monthly_volume_brl": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Monthly Volume Brl",
          "type": "string"
        },
        "out_fraction": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Out Fraction",
          "type": "string"
        },
        "profile": {
          "enum": [
            "remessa_outbound_massiva",
            "psp_inbound",
            "cripto_native_sem_fiat",
            "payroll_fornecedor",
            "exportador",
            "tesouraria_corporativa"
          ],
          "title": "Profile",
          "type": "string"
        },
        "purpose_in": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Purpose In",
          "type": "string"
        },
        "purpose_out": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Purpose Out",
          "type": "string"
        },
        "seed": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Seed",
          "type": "string"
        },
        "ticket_median_brl": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Ticket Median Brl",
          "type": "string"
        }
      },
      "required": [
        "id",
        "profile",
        "seed",
        "monthly_volume_brl",
        "ticket_median_brl",
        "out_fraction",
        "deadline",
        "eh_efx",
        "purpose_out",
        "purpose_in"
      ],
      "title": "EffectiveParticipant",
      "type": "object"
    },
    "EffectiveSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PADRAO_SINTETICO",
            "ESTIMATIVA_USUARIO"
          ],
          "title": "Kind",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "recorded_at"
      ],
      "title": "EffectiveSource",
      "type": "object"
    },
    "EstatisticaPrevia": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "const": 1,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "const": "SINGLE_EXECUTION",
          "title": "Kind",
          "type": "string"
        },
        "percentile_method": {
          "title": "Percentile Method",
          "type": "null"
        },
        "repetition_id": {
          "format": "uuid",
          "title": "Repetition Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "null"
        }
      },
      "required": [
        "kind",
        "count",
        "seed",
        "repetition_id",
        "percentile_method"
      ],
      "title": "EstatisticaPrevia",
      "type": "object"
    },
    "ExampleParticipant": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "remessa_outbound_massiva",
            "psp_inbound",
            "cripto_native_sem_fiat",
            "payroll_fornecedor",
            "exportador",
            "tesouraria_corporativa"
          ],
          "title": "Profile",
          "type": "string"
        },
        "seed": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Seed",
          "type": "string"
        },
        "template_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "profile",
        "seed"
      ],
      "title": "ExampleParticipant",
      "type": "object"
    },
    "ExampleTemplate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "equilibrado",
            "retail_pesado",
            "corporativo_pesado",
            "psp_dominante",
            "outbound_extremo"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ExampleParticipant"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Participants",
          "type": "array"
        },
        "weights": {
          "additionalProperties": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "remessa_outbound_massiva",
              "psp_inbound",
              "cripto_native_sem_fiat",
              "payroll_fornecedor",
              "exportador",
              "tesouraria_corporativa"
            ]
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "weights",
        "participants"
      ],
      "title": "ExampleTemplate",
      "type": "object"
    },
    "FixedDeadline": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "maximum": 365,
          "minimum": 0,
          "title": "Days",
          "type": "integer"
        },
        "mode": {
          "const": "FIXED",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "days"
      ],
      "title": "FixedDeadline",
      "type": "object"
    },
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/$defs/ValidationError"
          },
          "title": "Detail",
          "type": "array"
        }
      },
      "title": "HTTPValidationError",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "InputSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cenario": {
          "$ref": "#/$defs/CenarioEntrada"
        },
        "periodo": {
          "oneOf": [
            {
              "$ref": "#/$defs/PeriodoLegado"
            },
            {
              "$ref": "#/$defs/PeriodoNatural"
            }
          ],
          "title": "Periodo"
        },
        "proveniencia": {
          "additionalProperties": {
            "$ref": "#/$defs/OrigemValor"
          },
          "title": "Proveniencia",
          "type": "object"
        }
      },
      "required": [
        "cenario",
        "periodo",
        "proveniencia"
      ],
      "title": "InputSnapshot",
      "type": "object"
    },
    "ManifestoDTO": {
      "additionalProperties": false,
      "properties": {
        "arquetipos": {
          "items": {
