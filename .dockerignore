# Deny by default: no repository history, documents, results or local context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements/
!requirements/web.lock
!requirements/build.lock
!motor/
!motor/**/
!motor/**/*.py
!motor/cenarios/
!motor/cenarios/exemplo_amanda.yaml
!servidor/
!servidor/**/
!servidor/**/*.py
!servidor/catalogs/*.json
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/vite.config.ts
!web/tsconfig.json
!web/src/
!web/src/**
# Defense in depth for any future expansion of the allowlist.
**/.git
**/.git/**
**/.worktrees/**
**/.env*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
**/coverage/**
**/test-results/**
**/playwright-report/**
**/__fixtures__/**
**/*.test.*
**/*.spec.*
web/src/test/**
web/src/**/testFixtures.*
web/src/**/fixtures.*
resultados/**
docs/**
tests/**
contracts/**
